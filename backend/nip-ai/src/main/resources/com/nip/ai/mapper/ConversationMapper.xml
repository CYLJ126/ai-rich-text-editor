<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nip.ai.mapper.ConversationMapper">
    <resultMap id="BaseResultMap" type="com.nip.ai.pojo.conversation.ConversationDto">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="conv_id" property="convId" jdbcType="VARCHAR"/>
        <result column="title" property="title" jdbcType="VARCHAR"/>
        <result column="assistant_id" property="assistantId" jdbcType="INTEGER"/>
        <result column="model_id" property="modelId" jdbcType="INTEGER"/>
        <result column="extra_param" property="extraParam"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="system_prompt" property="systemPrompt" jdbcType="LONGVARCHAR"/>
        <result column="knowledge_base_id" property="knowledgeBaseId" jdbcType="VARCHAR"/>
        <result column="context_window" property="contextWindow" jdbcType="INTEGER"/>
        <result column="max_tokens" property="maxTokens" jdbcType="INTEGER"/>
        <result column="top_k" property="topK" jdbcType="INTEGER"/>
        <result column="message_count" property="messageCount" jdbcType="INTEGER"/>
        <result column="last_message_id" property="lastMessageId" jdbcType="VARCHAR"/>
        <result column="context_strategy" property="contextStrategy" jdbcType="VARCHAR"/>
        <result column="reasoning_effort" property="reasoningEffort" jdbcType="VARCHAR"/>
        <result column="text_type" property="textType" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="scene" property="scene" jdbcType="VARCHAR"/>
        <result column="interaction_type" property="interactionType" jdbcType="VARCHAR"/>
        <result column="temperature" property="temperature" jdbcType="DECIMAL"/>
        <result column="top_p" property="topP" jdbcType="DECIMAL"/>
        <result column="presence_penalty" property="presencePenalty" jdbcType="DECIMAL"/>
        <result column="frequency_penalty" property="frequencyPenalty" jdbcType="DECIMAL"/>
        <result column="global_memory_flag" property="globalMemoryFlag" jdbcType="BOOLEAN"/>
        <result column="pin_flag" property="pinFlag" jdbcType="BOOLEAN"/>
        <result column="query_rewrite_flag" property="queryRewriteFlag" jdbcType="BOOLEAN"/>
        <result column="last_message_at" property="lastMessageAt" jdbcType="TIMESTAMP"/>
        <result column="last_message_digest" property="lastMessageDigest" jdbcType="VARCHAR"/>
        <result column="default_flag" property="defaultFlag" jdbcType="BOOLEAN"/>
        <result column="create_by" property="createBy" jdbcType="VARCHAR"/>
        <result column="update_by" property="updateBy" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        , conv_id, title, assistant_id, model_id, extra_param, system_prompt,
    knowledge_base_id, context_strategy, context_window, reasoning_effort,
    text_type, temperature, max_tokens, top_p, top_k,
    presence_penalty, frequency_penalty, global_memory_flag,
    status, pin_flag, query_rewrite_flag, scene, interaction_type,
    last_message_id, last_message_at, last_message_digest, message_count, default_flag,
    create_by, update_by, create_time, update_time
    </sql>

    <select id="getAndValidate" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from nip_ai_conversation
        where conv_id = #{convId}
    </select>

</mapper>