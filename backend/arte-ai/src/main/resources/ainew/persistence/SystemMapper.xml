<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.arte.ainew.persistence.mybatis.mapper.SystemMapper">
    <select id="databaseTime" resultType="java.sql.Timestamp" useCache="false">
        SELECT CURRENT_TIMESTAMP(3)
    </select>
    <insert id="ensureLock">
        <!-- 已存在时直接取得排他记录锁；INSERT IGNORE 的共享重复键锁会在并发 FOR UPDATE 升级时死锁。 -->
        INSERT INTO arte_ai_lock(lock_key) VALUES (#{key}) ON DUPLICATE KEY UPDATE lock_key=lock_key
    </insert>
    <select id="lock" resultType="java.lang.String" useCache="false">
        SELECT lock_key FROM arte_ai_lock WHERE lock_key=#{key} FOR UPDATE
    </select>
</mapper>
