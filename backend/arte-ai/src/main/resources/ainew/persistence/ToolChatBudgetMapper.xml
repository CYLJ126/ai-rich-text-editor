<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.arte.ainew.persistence.mybatis.mapper.ToolChatBudgetMapper">
    <resultMap id="Balance" type="com.arte.ainew.persistence.mybatis.mapper.ToolChatBudgetMapper$Balance">
        <constructor>
            <arg column="run_key" javaType="java.lang.String"/>
            <arg column="currency" javaType="java.lang.String"/>
            <arg column="version" javaType="_long"/>
            <arg column="digest" javaType="java.lang.String"/>
            <arg column="snapshot" javaType="java.lang.String"/>
        </constructor>
    </resultMap>
    <resultMap id="Allocation" type="com.arte.ainew.persistence.mybatis.mapper.ToolChatBudgetMapper$Allocation">
        <constructor>
            <arg column="run_key" javaType="java.lang.String"/>
            <arg column="invocation_key" javaType="java.lang.String"/>
            <arg column="attempt_key" javaType="java.lang.String"/>
            <arg column="attempt_number" javaType="_int"/>
            <arg column="charge_kind" javaType="java.lang.String"/>
            <arg column="reservation_key" javaType="java.lang.String"/>
            <arg column="digest" javaType="java.lang.String"/>
            <arg column="snapshot" javaType="java.lang.String"/>
        </constructor>
    </resultMap>
    <select id="balances" resultMap="Balance" useCache="false">
        SELECT * FROM arte_ai_tool_chat_budget WHERE run_key=#{run} ORDER BY currency
        <if test="lock">FOR UPDATE</if>
    </select>
    <insert id="insertBalance">
        INSERT INTO arte_ai_tool_chat_budget(run_key,currency,version,digest,snapshot)
        VALUES(#{b.runKey},#{b.currency},#{b.version},#{b.digest},#{b.snapshot})
    </insert>
    <update id="saveBalance">
        UPDATE arte_ai_tool_chat_budget SET version=#{b.version},digest=#{b.digest},snapshot=#{b.snapshot}
        WHERE run_key=#{b.runKey} AND currency=#{b.currency} AND version=#{expected}
    </update>
    <select id="allocation" resultMap="Allocation" useCache="false">
        SELECT * FROM arte_ai_tool_chat_budget_allocation WHERE reservation_key=#{reservation}
        <if test="lock">FOR UPDATE</if>
    </select>
    <insert id="insertAllocation">
        INSERT INTO
        arte_ai_tool_chat_budget_allocation(run_key,invocation_key,attempt_key,attempt_number,charge_kind,reservation_key,digest,snapshot)
        VALUES(#{a.runKey},#{a.invocationKey},#{a.attemptKey},#{a.attemptNumber},#{a.chargeKind},#{a.reservationKey},#{a.digest},#{a.snapshot})
    </insert>
    <update id="saveAllocation">
        UPDATE arte_ai_tool_chat_budget_allocation SET digest=#{a.digest},snapshot=#{a.snapshot}
        WHERE reservation_key=#{a.reservationKey} AND run_key=#{a.runKey} AND attempt_key=#{a.attemptKey}
    </update>
</mapper>
