<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.arte.ai.mapper.MessageMapper">

    <resultMap id="BaseResultMap" type="com.arte.ai.pojo.message.MessageDto">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="message_id" property="messageId" jdbcType="VARCHAR"/>
        <result column="conv_id" property="convId" jdbcType="VARCHAR"/>
        <result column="parent_message_id" property="parentMessageId" jdbcType="VARCHAR"/>
        <result column="branch_id" property="branchId" jdbcType="VARCHAR"/>
        <result column="branch_index" property="branchIndex" jdbcType="INTEGER"/>
        <result column="role" property="role" jdbcType="VARCHAR"/>
        <result column="content" property="content" jdbcType="LONGVARCHAR"/>
        <result column="optimized_content" property="optimizedContent" jdbcType="LONGVARCHAR"/>
        <result column="text_type" property="textType" jdbcType="VARCHAR"/>
        <result column="model_id" property="modelId" jdbcType="VARCHAR"/>
        <result column="model_param" property="modelParam"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="reasoning_content" property="reasoningContent" jdbcType="LONGVARCHAR"/>
        <result column="tool_calls" property="toolCalls"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="quoted_message_id" property="quotedMessageId" jdbcType="VARCHAR"/>
        <result column="quoted_snapshot" property="quotedSnapshot" jdbcType="LONGVARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="like_status" property="likeStatus" jdbcType="INTEGER"/>
        <result column="delete_flag" property="deleteFlag" jdbcType="BOOLEAN"/>
        <result column="finish_reason" property="finishReason" jdbcType="VARCHAR"/>
        <result column="prompt_token" property="promptToken" jdbcType="INTEGER"/>
        <result column="completion_token" property="completionToken" jdbcType="INTEGER"/>
        <result column="total_token" property="totalToken" jdbcType="INTEGER"/>
        <result column="reasoning_token" property="reasoningToken" jdbcType="INTEGER"/>
        <result column="latency_ms" property="latencyMs" jdbcType="BIGINT"/>
        <result column="first_token_ms" property="firstTokenMs" jdbcType="BIGINT"/>
        <result column="prompt_cost" property="promptCost" jdbcType="DECIMAL"/>
        <result column="completion_cost" property="completionCost" jdbcType="DECIMAL"/>
        <result column="currency" property="currency" jdbcType="VARCHAR"/>
        <result column="error_code" property="errorCode" jdbcType="VARCHAR"/>
        <result column="error_message" property="errorMessage" jdbcType="LONGVARCHAR"/>
        <result column="retry_count" property="retryCount" jdbcType="INTEGER"/>
        <result column="request_id" property="requestId" jdbcType="VARCHAR"/>
        <result column="create_by" property="createBy" jdbcType="VARCHAR"/>
        <result column="update_by" property="updateBy" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectMainBranchMessages" resultMap="BaseResultMap">
        SELECT *
        FROM arte_ai_message
        WHERE conv_id = #{convId}
          AND delete_flag = 0
        ORDER BY id DESC, create_time DESC
            limit #{limit}
    </select>

    <select id="selectMessagesBefore" resultMap="BaseResultMap">
        SELECT *
        FROM arte_ai_message
        WHERE conv_id = #{convId}
          AND id &lt; #{beforeId}
          AND delete_flag = 0
        ORDER BY id DESC, create_time DESC
            limit #{limit}
    </select>

    <!--
        模型历史上下文只加载用户、系统和最终助手消息。
        工具协议消息仍保存在 arte_ai_message 中，用于审计和调用链展示，但不占用上下文窗口。
    -->
    <select id="selectConversationContextMessages" resultMap="BaseResultMap">
        SELECT *
        FROM arte_ai_message
        WHERE conv_id = #{convId}
          AND delete_flag = 0
          AND (
            role IN ('user', 'system')
                OR (role = 'assistant' AND COALESCE(JSON_LENGTH(tool_calls), 0) = 0)
            )
        ORDER BY id DESC, create_time DESC
            limit #{limit}
    </select>

    <select id="selectConversationContextMessagesBefore" resultMap="BaseResultMap">
        SELECT *
        FROM arte_ai_message
        WHERE conv_id = #{convId}
          AND id &lt; #{beforeId}
          AND delete_flag = 0
          AND (
            role IN ('user', 'system')
                OR (role = 'assistant' AND COALESCE(JSON_LENGTH(tool_calls), 0) = 0)
            )
        ORDER BY id DESC, create_time DESC
            limit #{limit}
    </select>

    <!-- 批量软删除 -->
    <update id="batchSoftDelete">
        UPDATE arte_ai_message
        SET delete_flag = 1,
        update_time = NOW()
        WHERE message_id IN
        <foreach collection="messageIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
