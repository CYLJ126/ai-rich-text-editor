<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.arte.ai.mapper.tool.WorkflowVersionMapper">
    <resultMap id="BaseResultMap" type="com.arte.ai.pojo.tool.po.WorkflowVersionPo" autoMapping="true">
        <result column="input_schema" property="inputSchema"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="output_schema" property="outputSchema"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="nodes" property="nodes"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="edges" property="edges"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="compiled_plan" property="compiledPlan"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="pinned_tools" property="pinnedTools"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>
    <select id="selectExact" resultMap="BaseResultMap">
        SELECT *
        FROM arte_ai_workflow_version
        WHERE workflow_id = #{workflowId}
          AND version = #{version} LIMIT 1
    </select>
    <select id="selectVersions" resultMap="BaseResultMap">
        SELECT *
        FROM arte_ai_workflow_version
        WHERE workflow_id = #{workflowId}
        ORDER BY create_time DESC
    </select>
    <update id="publish">
        UPDATE arte_ai_workflow_version
        SET lifecycle_state = 'published',
            published_at    = #{publishedAt},
            row_version     = row_version + 1,
            update_time     = CURRENT_TIMESTAMP(3)
        WHERE id = #{id}
          AND row_version = #{expectedVersion}
          AND lifecycle_state = 'draft'
    </update>
</mapper>
