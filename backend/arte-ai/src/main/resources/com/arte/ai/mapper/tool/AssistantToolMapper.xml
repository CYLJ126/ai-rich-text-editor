<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.arte.ai.mapper.tool.AssistantToolMapper">
    <resultMap id="BaseResultMap" type="com.arte.ai.pojo.tool.po.AssistantToolPo" autoMapping="true">
        <result column="policy_override" property="policyOverride"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>
    <select id="selectEnabledByAssistantId" resultMap="BaseResultMap">
        SELECT *
        FROM arte_ai_assistant_tool
        WHERE assistant_id = #{assistantId}
          AND enabled = 1
        ORDER BY sort_order, id
    </select>
</mapper>
