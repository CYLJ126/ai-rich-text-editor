<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.arte.ai.mapper.tool.ToolMapper">
    <select id="selectByIdentity" resultType="com.arte.ai.pojo.tool.po.ToolPo">
        SELECT *
        FROM arte_ai_tool
        WHERE namespace = #{namespace}
          AND name = #{name} LIMIT 1
    </select>
    <select id="selectByProviderId" resultType="com.arte.ai.pojo.tool.po.ToolPo">
        SELECT *
        FROM arte_ai_tool
        WHERE provider_id = #{providerId}
        ORDER BY namespace, name
    </select>
</mapper>
