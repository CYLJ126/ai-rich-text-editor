<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.arte.ai.mapper.tool.ToolGuardrailMapper">
    <resultMap id="BaseResultMap" type="com.arte.ai.pojo.tool.po.ToolGuardrailPo" autoMapping="true">
        <result column="phases" property="phases"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="configuration" property="configuration"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>
    <select id="selectEnabled" resultMap="BaseResultMap">
        SELECT *
        FROM arte_ai_tool_guardrail
        WHERE enabled = 1
          AND (owner_id IS NULL OR owner_id = #{ownerId})
        ORDER BY priority DESC, id
    </select>
</mapper>
