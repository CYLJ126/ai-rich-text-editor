<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.arte.ai.mapper.tool.ToolCallResultMapper">
    <resultMap id="BaseResultMap" type="com.arte.ai.pojo.tool.po.ToolCallResultPo" autoMapping="true">
        <result column="output" property="output"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="content" property="content"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="artifacts" property="artifacts"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="usage_info" property="usageInfo"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="error_info" property="errorInfo"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="metadata" property="metadata"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>
    <select id="selectByCallId" resultMap="BaseResultMap">
        SELECT *
        FROM arte_ai_tool_call_result
        WHERE call_id = #{callId} LIMIT 1
    </select>
    <select id="selectByTaskId" resultMap="BaseResultMap">
        SELECT *
        FROM arte_ai_tool_call_result
        WHERE task_id = #{taskId} LIMIT 1
    </select>
</mapper>
