<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.arte.ai.mapper.tool.ToolProviderMapper">
    <resultMap id="BaseResultMap" type="com.arte.ai.pojo.tool.po.ToolProviderPo" autoMapping="true">
        <result column="config" property="config"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
    </resultMap>
    <select id="selectEnabled" resultMap="BaseResultMap">
        SELECT *
        FROM arte_ai_tool_provider
        WHERE status = 'enabled'
        ORDER BY id
    </select>
</mapper>
