# ======================== Server 配置 ========================
server.port=12636
server.servlet.context-path=/arte
# ======================== redis 配置 ========================
redis.singleServerConfig.address=redis://127.0.0.1:6379
redis.singleServerConfig.password=
# ======================== app 数据库连接池配置 ========================
spring.datasource.druid.app.url=your-database-url-here
spring.datasource.druid.app.username=your-database-username-here
spring.datasource.druid.app.password=your-database-password-here
# ======================== 另一个数据库连接池配置（暂无用处，可扩展多数据源），见 com.arte.app.config.DataSourceConfig ========================
spring.datasource.druid.chlorophyll.url=your-database-url-here
spring.datasource.druid.chlorophyll.username=your-database-username-here
spring.datasource.druid.chlorophyll.password=your-database-password-here
# ======================== Elasticsearch 配置 ========================
elasticsearch.uris=your-elasticsearch-uris-here
elasticsearch.username=your-elasticsearch-username-here
elasticsearch.password=your-elasticsearch-password-here
elasticsearch.connect-timeout=10s
elasticsearch.socket-timeout=60s
elasticsearch.connection-request-timeout=10s
elasticsearch.pool.max-conn-total=40
elasticsearch.pool.max-conn-per-route=20
elasticsearch.bulk.batch-size=500
elasticsearch.bulk.max-bytes-per-batch=5242880
elasticsearch.bulk.flush-interval=15s
elasticsearch.index.document-index=articles
elasticsearch.index.chunk-index=article_chunks
elasticsearch.index.document-shards=3
elasticsearch.index.document-replicas=1
elasticsearch.index.chunk-shards=5
elasticsearch.index.chunk-replicas=1
# ======================== 安全配置 ========================
security.sm2.privateKey=your-sm2-private-key-here
security.sm2.publicKey=your-sm2-public-key-here
# ======================== 代理配置 ========================
http.proxy.host=your-proxy-host-here
http.proxy.port=your-proxy-port-here
# ======================== 首页资讯网站配置 ========================
# 是否在启动时加载网站资讯，默认开启
arte.homepage.website.loadWhenStart=true
# ======================== 文件上传下载配置 ========================
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
# ======================== 日志配置 ========================
# es 交互时的日志级别
logging.level.org.apache.hc.client5.http.wire=INFO
logging.level.org.apache.hc.core5=INFO
# spring ai 包日志级别
logging.level.org.springframework.ai=DEBUG
# spring ai advisor 日志级别
logging.level.org.springframework.ai.chat.client.advisor=DEBUG
# ======================== AI HTTP / TOOL 观测配置 ========================
# 接入 HTTP 指标、JDBC 统计、Reactor 上下文传播和持久化调度器观测；默认开启。
arte.observability.ai-http.enabled=true
# 输出阶段耗时 / SQL / 剩余期限和生命周期点：AI_TOOL_STAGE、AI_TOOL_POINT。
logging.level.com.arte.core.diagnostics.OperationObservation=INFO
# 输出新 AI 请求汇总：AI_HTTP_METRICS。
logging.level.com.arte.app.diagnostics.NewAiHttpObservationFilter=INFO
# 关闭基础设施开关不会屏蔽所有阶段日志；停用上述日志需将对应级别调为 WARN 或 OFF。
# 修改后需重新生成 Maven 资源并重启后端。
# ======================== 文章相关配置 ========================
# 历史版本最大数量
rich-text.history.max-versions=20
# ES 同步延迟时间，单位毫秒
rich-text.es-sync.delay-ms=300000
# ES 同步扫描间隔，单位毫秒
rich-text.es-sync.scan-interval-ms=10000
# ES 同步重试延迟时间，单位毫秒
rich-text.es-sync.retry-delay-ms=60000
# ES 同步批量大小
rich-text.es-sync.batch-size=100
# 存储类型
rich-text.storage.type=QINIU
rich-text.storage.local.image-path=your-local-image-path-here
rich-text.storage.local.file-path=your-local-file-path-here
rich-text.storage.qiniu.access-key=your-qiniu-access-key-here
rich-text.storage.qiniu.secret-key=your-qiniu-secret-key-here
rich-text.storage.qiniu.bucket=your-qiniu-bucket-here
rich-text.storage.qiniu.domain=your-qiniu-domain-here
rich-text.storage.qiniu.image-expire-days=7
# ======================== 嵌入模型配置 ========================
# bge-large（1024 维度）或 bge-small（Bge 512 维度），bge 需要配置 onnx 文件
spring.ai.embedding.provider=bge-large
# 注：在 bge-small 时需要
spring.ai.embedding.exclude=
# 注：以下配置在 bge-large 时需
# onnx文件
spring.ai.embedding.transformer.onnx.model-uri=file://your-onnx-model-path-here
spring.ai.embedding.transformer.tokenizer.uri=file://your-tokenizer-path-here
# -1 表示使用 CPU，Mac 上可尝试 0 调用 GPU（需配合 CoreML）
spring.ai.embedding.transformer.onnx.gpu-device-id=-1
# 重要，防止输入长度不一致报错
spring.ai.embedding.transformer.tokenizer.options.padding=true
# ======================== Spring AI 配置 ========================
# Legacy Spring AI also reads the process environment; no plaintext key in build resources.
spring.ai.deepseek.api-key=${ARTE_DEEPSEEK_API_KEY}
# ======================== mcp client 配置 ========================
spring.ai.mcp.client.name=arte-mcp-client
# ======================== mcp server 配置 ========================
spring.ai.mcp.server.name=arte-mcp-server
# 配置路径为 项目根路径加端点路径，如 http://localhost:8000/arte/mcp
spring.ai.mcp.server.endpoint=/mcp
spring.ai.mcp.server.disallow-delete=true

# ======================== Public platform / workspace ========================
# Filtered into classpath:platform/config/application.properties, imported by application.yml.
# Rebuild Maven resources and restart the application after changing these values.
# 安装公共身份和工作空间表，参见 ../arte-app/docs/PLATFORM_PERSISTENCE.md。
# 下方账号 ID、迁移上限和主体 ID 是示例。部署前按目标库核对并替换。
arte.platform.identity.enabled=true
# 必填。填写该环境迁移时核定的旧账号 ID 上限。
arte.platform.identity.legacy-user-id-ceiling=1798873089
# 必填。填写待绑定账号在 arte_rbac_user 表中的实际数字 ID。
arte.platform.identity.bindings[0].user-id=1
# 升级时沿用已有稳定主体 ID，以保留原有授权、预算和会话归属。
arte.platform.identity.bindings[0].subject-id=example-subject-id

arte.platform.persistence.enabled=true
# Space CRUD does not require event delivery. Enable when testing Redis Streams / Outbox consumers.
arte.platform.persistence.outbox-enabled=false
# Advanced persistence defaults are in common.properties. Override individual keys here as needed.

arte.platform.workspace.enabled=true
# NEW personal tenant defaults are versioned in the database; see arte-app/docs/PLATFORM_WORKSPACE_POLICY.md.
# Existing policies change only through authorized governance commands.

# ======================== New AI DATABASE 配置 ========================
# Maven filters this file into classpath:ainew/config/application.properties.
# application-ai.yml imports that runtime file; changing this file requires rebuilding resources.
# 1. 启动前在 appDataSource 所用 MySQL 库安装新 AI 执行、控制面和模型表。
#    依赖和安装顺序见 ../arte-app/docs/MODEL_CONFIGURATION_M5.md 的「新装和部署边界」。
#    另执行 arte-ai-model-egress-policy-ddl-mysql.sql 和 arte-ai-model-egress-rbac-dml-mysql.sql。
# 2. 显式授予平台安全人员 aiSecurity:manageEgress，并分配「环境配置」和「模型配置」菜单。
#    启动后在「环境配置 → 模型配置 → 平台出口策略」保存供应商 origin，例如 https://api.deepseek.com。
#    初始名单为空，供应商连接发布、连接测试和模型外发均需匹配白名单。
# 3. 由平台配置人员在「供应商连接」发布审核连接，再到「模型方案与费率」发布审核方案。
#    空目录可直接发布第一条连接。随后在「模型管理」按审核方案创建、验证和发布实际模型。
#    出口安装与授权详情见 ../arte-app/docs/PLATFORM_AI_CONTROL.md 的「平台模型出口策略」。
arte.ai-new.configuration-mode=DATABASE
arte.ai-new.enabled=true
# TOOL 显式登记与手动发现；开启前须部署目录表并提供 StaticToolRegistry Bean。
arte.ai-new-tool.enabled=true
arte.ai-new-tool.discovery.refresh-on-startup=true
# Tool chat and its Run worker require the S4 migrations and an execution worker.
arte.ai-new-tool-chat.enabled=true
arte.ai-new-tool-chat.worker-enabled=true
arte.ai-new-tool-chat.poll-interval=1s
arte.ai-new-tool-chat.lease=45s
arte.ai-new-tool-chat.batch-size=8
# Set true for the first upgraded startup after applying the metadata migration.
arte.ai-new.conversation-metadata-backfill.enabled=true
arte.ai-new.data-source-bean=appDataSource
arte.ai-new.release-ref=example-release-v1

# 审核配置、实际模型、授权及预算均由数据库保存。FIXED 部署另见 fixed-models.properties.example。

# 下方是环境变量凭据引用。使用这些引用的部署将 ARTE_DEEPSEEK_API_KEY 注入实际 Java 进程。
# DATABASE 模式下，实际模型的个人或租户凭据在「模型管理」中维护。
arte.ai-new-generation.enabled=true
arte.ai-new-generation.secrets[0].reference.type=secret
arte.ai-new-generation.secrets[0].reference.id=example-credential
arte.ai-new-generation.secrets[0].reference.version=v1
arte.ai-new-generation.secrets[0].environment-variable=ARTE_DEEPSEEK_API_KEY

# Manual dispatch by default; set worker-enabled=true for automatic database polling.
# Execute the manual DDL and initialize the budget first. No startup DDL/account creation.
arte.ai-new-execution.enabled=true
arte.ai-new-execution.worker-enabled=false
# Worker tuning, dispatch limits, and retry defaults are in common.properties.

# AI SSE notification transport (reuse application RedissonClient).
arte.ai-new-events.transport=local
# Redis deployments can override the channel and publish timeout from common.properties.

# Conversation search. Apply the search MySQL migration before startup.
# Initialize the index, expose queries, and keep historical/new conversations synchronized.
arte.ai-new-search.enabled=${ARTE_AI_NEW_SEARCH_ENABLED:true}
arte.ai-new-search.initialize-on-startup=${ARTE_AI_NEW_SEARCH_INITIALIZE_ON_STARTUP:true}
arte.ai-new-search.query-enabled=${ARTE_AI_NEW_SEARCH_QUERY_ENABLED:true}
arte.ai-new-search.scan-enabled=${ARTE_AI_NEW_SEARCH_SCAN_ENABLED:true}
arte.ai-new-search.backfill-enabled=${ARTE_AI_NEW_SEARCH_BACKFILL_ENABLED:true}
arte.ai-new-search.reconcile-enabled=${ARTE_AI_NEW_SEARCH_RECONCILE_ENABLED:true}
arte.ai-new-search.sync.generation=${ARTE_AI_NEW_SEARCH_GENERATION:conversation-search-v2-g01}

# S2-06: deploy scheduling migration and drain legacy DISPATCH first; then enable on every worker.
# When enabled set arte.ai-new-execution.concurrency to the slot total (6 with the slots in common.properties).
# Set tool-manifest to the reviewed StaticToolDiscovery snapshot SHA-256 for TOOL readiness.
arte.ai-new-execution.scheduling.enabled=false

# 开启业务写工具
arte.ai-new-tool-write.enabled=true
# 启用人工确认与审批
arte.ai-new-tool-approval.enabled=true

# S5-01: enable only after reviewing the fixed endpoint, network origin and deployment manifest.
arte.ai-new-tool-http.enabled=false
arte.ai-new-tool-http.version=v1
arte.ai-new-tool-http.endpoint=
arte.ai-new-tool-http.allowed-origins=

# S5-02: apply billing migration and upgrade consumers before enabling.
arte.ai-new-tool-billing.enabled=false

# S5-03: reviewed MCP Streamable HTTP health tool; enable only after consumer/manifest upgrade.
arte.ai-new-tool-mcp.enabled=true
arte.ai-new-tool-mcp.version=v1
arte.ai-new-tool-mcp.endpoint=
arte.ai-new-tool-mcp.allowed-origins=

# 开启模型管理功能
arte.ai-new-model-management.enabled=true
arte.ai-new-model-publication.enabled=true
# 安装 arte-ai-model-sharing-ddl-mysql.sql 并升级全部节点后，才可开启租户模型。
arte.ai-new-model-sharing.enabled=true
# 环境变量中还要添加（用 Sm4Util.generateKeyBase64 生成 KEY）：ARTE_MODEL_CREDENTIAL_KEY=bxxedw/TnSnR9422ANDwlw==

