# ======================== Server 配置 ========================
server.port=12636
server.servlet.context-path=/arte
# ======================== redis 配置 ========================
redis.singleServerConfig.address=redis://127.0.0.1:6379
redis.singleServerConfig.password=
# ======================== app 数据库连接池配置 ========================
spring.datasource.druid.app.url=your-database-url-here
spring.datasource.druid.app.username=your-database-username-here
spring.datasource.druid.app.password=your-database-password-here
# ======================== 另一个数据库连接池配置（暂无用处，可扩展多数据源），见 com.arte.app.config.DataSourceConfig ========================
spring.datasource.druid.chlorophyll.url=your-database-url-here
spring.datasource.druid.chlorophyll.username=your-database-username-here
spring.datasource.druid.chlorophyll.password=your-database-password-here
# ======================== Elasticsearch 配置 ========================
elasticsearch.uris=your-elasticsearch-uris-here
elasticsearch.username=your-elasticsearch-username-here
elasticsearch.password=your-elasticsearch-password-here
elasticsearch.connect-timeout=10s
elasticsearch.socket-timeout=60s
elasticsearch.connection-request-timeout=10s
elasticsearch.pool.max-conn-total=40
elasticsearch.pool.max-conn-per-route=20
elasticsearch.bulk.batch-size=500
elasticsearch.bulk.max-bytes-per-batch=5242880
elasticsearch.bulk.flush-interval=15s
elasticsearch.index.document-index=articles
elasticsearch.index.chunk-index=article_chunks
elasticsearch.index.document-shards=3
elasticsearch.index.document-replicas=1
elasticsearch.index.chunk-shards=5
elasticsearch.index.chunk-replicas=1
# ======================== 安全配置 ========================
security.sm2.privateKey=your-sm2-private-key-here
security.sm2.publicKey=your-sm2-public-key-here
# ======================== 代理配置 ========================
http.proxy.host=your-proxy-host-here
http.proxy.port=your-proxy-port-here
# ======================== 首页资讯网站配置 ========================
# 是否在启动时加载网站资讯，默认开启
arte.homepage.website.loadWhenStart=true
# ======================== 文件上传下载配置 ========================
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
# ======================== 日志配置 ========================
# es 交互时的日志级别
logging.level.org.apache.hc.client5.http.wire=INFO
logging.level.org.apache.hc.core5=INFO
# spring ai 包日志级别
logging.level.org.springframework.ai=DEBUG
# spring ai advisor 日志级别
logging.level.org.springframework.ai.chat.client.advisor=DEBUG
# ======================== 文章相关配置 ========================
# 历史版本最大数量
rich-text.history.max-versions=20
# ES 同步延迟时间，单位毫秒
rich-text.es-sync.delay-ms=300000
# ES 同步扫描间隔，单位毫秒
rich-text.es-sync.scan-interval-ms=10000
# ES 同步重试延迟时间，单位毫秒
rich-text.es-sync.retry-delay-ms=60000
# ES 同步批量大小
rich-text.es-sync.batch-size=100
# 存储类型
rich-text.storage.type=QINIU
rich-text.storage.local.image-path=your-local-image-path-here
rich-text.storage.local.file-path=your-local-file-path-here
rich-text.storage.qiniu.access-key=your-qiniu-access-key-here
rich-text.storage.qiniu.secret-key=your-qiniu-secret-key-here
rich-text.storage.qiniu.bucket=your-qiniu-bucket-here
rich-text.storage.qiniu.domain=your-qiniu-domain-here
rich-text.storage.qiniu.image-expire-days=7
# ======================== 嵌入模型配置 ========================
# bge-large（1024 维度）或 bge-small（Bge 512 维度），bge 需要配置 onnx 文件
spring.ai.embedding.provider=bge-large
# 注：在 bge-small 时需要
spring.ai.embedding.exclude=
# 注：以下配置在 bge-large 时需
# onnx文件
spring.ai.embedding.transformer.onnx.model-uri=file://your-onnx-model-path-here
spring.ai.embedding.transformer.tokenizer.uri=file://your-tokenizer-path-here
# -1 表示使用 CPU，Mac 上可尝试 0 调用 GPU（需配合 CoreML）
spring.ai.embedding.transformer.onnx.gpu-device-id=-1
# 重要，防止输入长度不一致报错
spring.ai.embedding.transformer.tokenizer.options.padding=true
# ======================== Spring AI 配置 ========================
# Legacy Spring AI also reads the process environment; no plaintext key in build resources.
spring.ai.deepseek.api-key=${ARTE_DEEPSEEK_API_KEY}
# ======================== mcp client 配置 ========================
spring.ai.mcp.client.name=arte-mcp-client
# ======================== mcp server 配置 ========================
spring.ai.mcp.server.name=arte-mcp-server
# 配置路径为 项目根路径加端点路径，如 http://localhost:8000/arte/mcp
spring.ai.mcp.server.endpoint=/mcp
spring.ai.mcp.server.disallow-delete=true

# ======================== New AI fixed configuration ========================
# Maven filters this file into classpath:ainew/config/application.properties.
# application-ai.yml imports that runtime file; changing this file requires rebuilding resources.
# These values match examples/ainew-generation.yml; the example identity/rates are for testing.
arte.ai-new.enabled=true
arte.ai-new.data-source-bean=appDataSource
arte.ai-new.release-ref=example-release-v1
arte.ai-new.persistence.threads=4
arte.ai-new.persistence.queued-tasks=256
arte.ai-new.limits.max-input-bytes=65536
arte.ai-new.limits.max-output-tokens=4096
arte.ai-new.limits.max-output-bytes=1048576
arte.ai-new.limits.maximum-timeout=2m
arte.ai-new.limits.snapshot-retention=15m

# Trusted authorization: subject-name must equal Authentication.getName().
# For a real login, replace the example identity and keep the budget owner in sync.
arte.ai-new.grants[0].subject-name=example-user
arte.ai-new.grants[0].subject-id=example-subject-id
arte.ai-new.grants[0].principal-kind=USER
arte.ai-new.grants[0].tenant-id=example-tenant
arte.ai-new.grants[0].workspace-id=example-workspace
arte.ai-new.grants[0].grant-ref=example-grant-v1
arte.ai-new.grants[0].enabled=true
arte.ai-new.grants[0].scopes=ai:invoke,ai:conversation,ai:read,ai:budget:admin
arte.ai-new.grants[0].binding-ids=default-text
arte.ai-new.grants[0].budget-refs=example-budget

# Capability and schemas; the runtime template reuses this descriptor for binding.capability.
arte.ai-new.capabilities[0].definition.type=capability
arte.ai-new.capabilities[0].definition.id=text-generation
arte.ai-new.capabilities[0].definition.version=v1
arte.ai-new.capabilities[0].kind=GENERATION
arte.ai-new.capabilities[0].input-schema.type=schema
arte.ai-new.capabilities[0].input-schema.id=generation-request
arte.ai-new.capabilities[0].input-schema.version=v1
arte.ai-new.capabilities[0].output-schema.type=schema
arte.ai-new.capabilities[0].output-schema.id=model-result
arte.ai-new.capabilities[0].output-schema.version=v1
arte.ai-new.capabilities[0].features=TEXT_INPUT,STREAMING,USAGE_REPORTING
arte.ai-new.capabilities[0].side-effect=READ_ONLY
arte.ai-new.capabilities[0].availability=EXECUTABLE

# Fixed binding: conservative input+output context capacity, and a fixed rate version.
arte.ai-new.bindings[0].definition.type=binding
arte.ai-new.bindings[0].definition.id=default-text
arte.ai-new.bindings[0].definition.version=v1
arte.ai-new.bindings[0].connection.type=connection
arte.ai-new.bindings[0].connection.id=default-model
arte.ai-new.bindings[0].connection.version=v1
arte.ai-new.bindings[0].remote-operation=deepseek-chat
# Multi-turn test capacity: input 32768 plus reserved output 512 fits this application limit.
arte.ai-new.bindings[0].context-window-tokens=65536
arte.ai-new.bindings[0].rate.type=rate
arte.ai-new.bindings[0].rate.id=example-rate
arte.ai-new.bindings[0].rate.version=v1

# Connection: endpoint is a base URL; allowed-origins below must not contain /v1.
arte.ai-new.connections[0].definition.type=connection
arte.ai-new.connections[0].definition.id=default-model
arte.ai-new.connections[0].definition.version=v1
arte.ai-new.connections[0].provider-id=deepseek
arte.ai-new.connections[0].protocol.type=protocol
arte.ai-new.connections[0].protocol.id=chat-completions-sse
arte.ai-new.connections[0].protocol.version=v1
arte.ai-new.connections[0].endpoint=https://api.deepseek.com/v1
arte.ai-new.connections[0].credential.type=secret
arte.ai-new.connections[0].credential.id=example-credential
arte.ai-new.connections[0].credential.version=v1
arte.ai-new.connections[0].state=ENABLED
arte.ai-new.connections[0].connect-timeout=5s
arte.ai-new.connections[0].response-timeout=2m
arte.ai-new.connections[0].max-response-bytes=1048576

# Example prices per million tokens, NOT current provider prices; replace before billed use.
arte.ai-new.rates[0].definition.type=rate
arte.ai-new.rates[0].definition.id=example-rate
arte.ai-new.rates[0].definition.version=v1
arte.ai-new.rates[0].input-per-million.amount=1
arte.ai-new.rates[0].input-per-million.currency=CNY
arte.ai-new.rates[0].output-per-million.amount=2
arte.ai-new.rates[0].output-per-million.currency=CNY

# Configuration does not create the database account.
# Call BudgetAccountInitializer.initialize with ai:budget:admin before submit.
arte.ai-new.budgets[0].budget-ref=example-budget
arte.ai-new.budgets[0].owner.tenant-id=example-tenant
arte.ai-new.budgets[0].owner.workspace-id=example-workspace
arte.ai-new.budgets[0].owner.subject-id=example-subject-id
arte.ai-new.budgets[0].limit.amount=100
arte.ai-new.budgets[0].limit.currency=CNY
arte.ai-new.budgets[0].rate.type=rate
arte.ai-new.budgets[0].rate.id=example-rate
arte.ai-new.budgets[0].rate.version=v1

# ARTE_DEEPSEEK_API_KEY 配置位置（此文件只写变量名称，不保存真实 Key）：
# Environment variables 中配置 ARTE_DEEPSEEK_API_KEY，或从加载变量的终端重启 IDE。
# 服务器/容器：将变量注入实际 Java 应用进程；只给 Maven 构建进程配置还不够。
# 修改本文件或 app.properties 后需重新构建资源；不会自动建表或初始化预算账户。
arte.ai-new-generation.enabled=true
arte.ai-new-generation.allowed-origins=https://api.deepseek.com
arte.ai-new-generation.secrets[0].reference.type=secret
arte.ai-new-generation.secrets[0].reference.id=example-credential
arte.ai-new-generation.secrets[0].reference.version=v1
arte.ai-new-generation.secrets[0].environment-variable=ARTE_DEEPSEEK_API_KEY
arte.ai-new-generation.max-pools=32
arte.ai-new-generation.connections-per-pool=8
arte.ai-new-generation.pending-acquires=32
arte.ai-new-generation.acquire-timeout=5s
arte.ai-new-generation.max-frame-bytes=65536
arte.ai-new-generation.max-request-bytes=1048576

# Manual dispatch by default; set worker-enabled=true for automatic database polling.
# Execute the manual DDL and initialize the budget first. No startup DDL/account creation.
arte.ai-new-execution.enabled=true
arte.ai-new-execution.worker-enabled=false
arte.ai-new-execution.concurrency=4
arte.ai-new-execution.poll-interval=1s
arte.ai-new-execution.outbox-lease=2m
arte.ai-new-execution.attempt-lease=2m
arte.ai-new-execution.reservation-retention=1d

# AI SSE notification transport (reuse application RedissonClient).
arte.ai-new-events.transport=local
arte.ai-new-events.channel=arte:ai-new:events:v1
arte.ai-new-events.publish-timeout=3s

# Shared dispatch limits and safe retry (max-attempts includes the first attempt).
arte.ai-new-execution.dispatch-limits.enabled=true
arte.ai-new-execution.dispatch-limits.global-concurrency=16
arte.ai-new-execution.dispatch-limits.tenant-concurrency=8
arte.ai-new-execution.dispatch-limits.user-concurrency=2
arte.ai-new-execution.dispatch-limits.model-concurrency=8
arte.ai-new-execution.dispatch-limits.global-requests=120
arte.ai-new-execution.dispatch-limits.tenant-requests=60
arte.ai-new-execution.dispatch-limits.user-requests=20
arte.ai-new-execution.dispatch-limits.model-requests=60
arte.ai-new-execution.dispatch-limits.window=1m
arte.ai-new-execution.retry.max-attempts=3
arte.ai-new-execution.retry.initial-backoff=1s
arte.ai-new-execution.retry.max-backoff=10s
