# AIRichTextEditor Docker Compose configuration
#
# compose-up.ps1 / compose-up.sh copies this file to .env on first run.
# The values below are convenient local defaults. Replace service passwords
# before exposing the deployment to an untrusted network.

# Published images
ARTE_REGISTRY=ghcr.io/cylj126
ARTE_IMAGE_NAME=ai-rich-text-editor
ARTE_VERSION=latest

# External MySQL / Elasticsearch mode (-External / --external).
# Defaults to ../backend/profile/app.properties in a source checkout.
# ARTE_BACKEND_CONFIG_FILE=C:/absolute/path/to/app.properties

# Public entrypoint
ARTE_BIND_ADDRESS=0.0.0.0
ARTE_PORT=8000
# Enable with -Https / --https. HTTP remains available on ARTE_PORT.
ARTE_HTTPS_PORT=8443
ARTE_TLS_CERT_FILE=./certs/fullchain.pem
ARTE_TLS_KEY_FILE=./certs/privkey.pem
TZ=Asia/Shanghai

# Runtime resources
JAVA_OPTS=-Xms512m -Xmx2g
ES_JAVA_OPTS=-Xms1g -Xmx1g

# MySQL
MYSQL_DATABASE=arte
MYSQL_ROOT_PASSWORD=arte_root_2026
MYSQL_USER=arte
MYSQL_PASSWORD=arte_mysql_2026

# Uncomment these only when using external databases.
# APP_DB_URL=jdbc:mysql://host.docker.internal:3306/arte?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
# CHLOROPHYLL_DB_URL=jdbc:mysql://host.docker.internal:3306/nip?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai

# Elasticsearch and optional Kibana
ELASTIC_PASSWORD=arte_elastic_2026
KIBANA_PASSWORD=arte_kibana_2026
KB_ENC_KEY=arte-encrypted-saved-objects-key-2026
KB_REPORTING_KEY=arte-reporting-encryption-key-2026
KB_SEC_KEY=arte-security-encryption-key-2026
KIBANA_BIND_ADDRESS=127.0.0.1
KIBANA_PORT=5601

# AI providers are configured in the application UI. This optional value only
# supplies a process-level default for the built-in DeepSeek adapter.
DEEPSEEK_API_KEY=not-configured

# Authentication and encryption
# Leave empty to generate once in the backend-secrets volume. Explicit values
# remain supported for migration; builds/restarts never rotate generated keys.
JWT_BASE64_SECRET_KEY=
JWT_DEFAULT_PASSWORD=arte@2026
SECURITY_SM2_PRIVATE_KEY=
SECURITY_SM2_PUBLIC_KEY=


# Frontend reverse proxy
NGINX_SERVER_NAME=_
NGINX_CLIENT_MAX_BODY_SIZE=50m
NGINX_ROOT_REDIRECT=/Writing/BasicWriting
NGINX_SPA_FALLBACK=/Welcome/index.html

# Optional outbound proxy used by the Java application, not by Docker itself.
HTTP_PROXY_HOST=
HTTP_PROXY_PORT=0
