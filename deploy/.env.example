# =============================================================================
# Docker deployment example
# 复制为 .env 后按需修改。多数变量在 docker-compose.yml 中已经有默认值；
# 这里尽量列出来，是为了让可配置项更容易发现。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 构建产物来源
# -----------------------------------------------------------------------------
# 必填。支持 http(s) 地址、绝对路径、相对路径。
NIP_APP_JAR_SOURCE=./nip-app-boot.jar
NIP_FRONT_DIST_SOURCE=./dist.zip

# 远程下载示例：填写 http(s) 地址。每次 ./compose-up.sh 都会重新下载。
# NIP_APP_JAR_SOURCE=https://image.haiqingd.top/nip-app-boot.jar
# NIP_FRONT_DIST_SOURCE=https://image.haiqingd.top/dist.zip

# -----------------------------------------------------------------------------
# 2. 宿主机端口映射
# -----------------------------------------------------------------------------
FRONTEND_HTTPS_PORT=8000
BACKEND_PORT=12636
MYSQL_PORT=3306
REDIS_PORT=6379
ES_PORT=9200
KIBANA_PORT=5601
DRAWIO_PORT=8080

# -----------------------------------------------------------------------------
# 3. Java / Elasticsearch JVM
# -----------------------------------------------------------------------------
JAVA_OPTS="-Xms512m -Xmx2g"
ES_JAVA_OPTS="-Xms1g -Xmx1g"

# -----------------------------------------------------------------------------
# 4. MySQL
# 使用内置 MySQL 时保持 mysql:3306。
# 使用外部 MySQL 时，把 host/URL/账号密码改成外部服务。
# 注意：容器内 localhost 指容器自己，不是宿主机。
# -----------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_DATABASE=nip
MYSQL_ROOT_PASSWORD=nip_root
MYSQL_USER=nip
MYSQL_PASSWORD=nip

APP_DB_URL=jdbc:mysql://mysql:3306/nip?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
APP_DB_USERNAME=nip
APP_DB_PASSWORD=nip

# CHLOROPHYLL_DB_URL=jdbc:mysql://mysql:3306/eladmin?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
# CHLOROPHYLL_DB_USERNAME=nip
# CHLOROPHYLL_DB_PASSWORD=nip

# Druid 连接池
# SPRING_DATASOURCE_DRUID_MIN_IDLE=5
# SPRING_DATASOURCE_DRUID_MAX_ACTIVE=10
# SPRING_DATASOURCE_DRUID_MAX_WAIT=5000
# SPRING_DATASOURCE_DRUID_VALIDATION_QUERY="select 1"
# SPRING_DATASOURCE_DRUID_TEST_WHILE_IDLE=true
# SPRING_DATASOURCE_DRUID_TEST_ON_BORROW=false
# SPRING_DATASOURCE_DRUID_TEST_ON_RETURN=false
# SPRING_DATASOURCE_DRUID_TIME_BETWEEN_EVICTION_RUNS_MILLIS=60000
# SPRING_DATASOURCE_DRUID_MIN_EVICTABLE_IDLE_TIME_MILLIS=300000
# SPRING_DATASOURCE_DRUID_MAX_EVICTABLE_IDLE_TIME_MILLIS=900000

# Druid 监控页面，默认路径 /nip/druid/*
# SPRING_DATASOURCE_DRUID_WEB_STAT_FILTER_ENABLED=true
# SPRING_DATASOURCE_DRUID_STAT_VIEW_SERVLET_ENABLED=true
# SPRING_DATASOURCE_DRUID_STAT_VIEW_SERVLET_URL_PATTERN=/druid/*
# SPRING_DATASOURCE_DRUID_STAT_VIEW_SERVLET_RESET_ENABLE=false
# SPRING_DATASOURCE_DRUID_STAT_VIEW_SERVLET_LOGIN_USERNAME=admin
# SPRING_DATASOURCE_DRUID_STAT_VIEW_SERVLET_LOGIN_PASSWORD=Aa111111
# SPRING_DATASOURCE_DRUID_FILTER_STAT_ENABLED=true
# SPRING_DATASOURCE_DRUID_FILTER_STAT_LOG_SLOW_SQL=true
# SPRING_DATASOURCE_DRUID_FILTER_STAT_SLOW_SQL_MILLIS=1000
# SPRING_DATASOURCE_DRUID_FILTER_STAT_MERGE_SQL=true
# SPRING_DATASOURCE_DRUID_FILTER_WALL_CONFIG_MULTI_STATEMENT_ALLOW=true

# -----------------------------------------------------------------------------
# 5. Redis / cache
# -----------------------------------------------------------------------------
REDIS_ADDRESS=redis://redis:6379
REDIS_PASSWORD=

# CACHE_CACHE_TYPE=redis
# CACHE_SCAN_PACKAGES=com.nip.app.pojo,com.nip.ai.pojo.model
# CACHE_DEFAULT_EXPIRE=60000
# CACHE_DEFAULT_MAX_SIZE=65536
# CACHE_DEFAULT_CACHE_KEY_PREFIX=NIP

# -----------------------------------------------------------------------------
# 6. Elasticsearch / Kibana
# -----------------------------------------------------------------------------
ELASTICSEARCH_URIS=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTIC_PASSWORD=密码1
KIBANA_PASSWORD=密码2
KIBANA_ELASTICSEARCH_HOSTS=http://elasticsearch:9200

# Kibana 8.x 加密密钥，建议生产环境换成 32 位以上随机字符串
KB_ENC_KEY=密钥1
KB_SEC_KEY=密钥2

SPRING_ELASTICSEARCH_VERSION=8
ELASTICSEARCH_CONNECT_TIMEOUT=10s
ELASTICSEARCH_SOCKET_TIMEOUT=60s
ELASTICSEARCH_CONNECTION_REQUEST_TIMEOUT=10s
ELASTICSEARCH_POOL_MAX_CONN_TOTAL=40
ELASTICSEARCH_POOL_MAX_CONN_PER_ROUTE=20
ELASTICSEARCH_BULK_BATCH_SIZE=500
ELASTICSEARCH_BULK_MAX_BYTES_PER_BATCH=5242880
ELASTICSEARCH_BULK_FLUSH_INTERVAL=15s
ELASTICSEARCH_INDEX_DOCUMENT_INDEX=articles
ELASTICSEARCH_INDEX_CHUNK_INDEX=article_chunks
ELASTICSEARCH_INDEX_DOCUMENT_SHARDS=1
ELASTICSEARCH_INDEX_DOCUMENT_REPLICAS=0
ELASTICSEARCH_INDEX_CHUNK_SHARDS=1
ELASTICSEARCH_INDEX_CHUNK_REPLICAS=0

# -----------------------------------------------------------------------------
# 7. 后端基础配置
# -----------------------------------------------------------------------------
SERVER_PORT=12636
SERVER_SERVLET_CONTEXT_PATH=/nip
SPRING_APPLICATION_NAME=NobodyIsPerfect

LOGGING_CONFIG=classpath:log4j2.xml
LOG_PATH=/usr/local/data/log/NobodyIsPerfect
LOG_FILE_NAME=NobodyIsPerfect

THREAD_POOL_BUSINESS_CORE_SIZE=5
THREAD_POOL_BUSINESS_MAX_SIZE=50
THREAD_POOL_BUSINESS_KEEP_ALIVE_TIME=300
THREAD_POOL_BUSINESS_QUEUE_SIZE=1024

# 上传大小
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=10MB

# 后端出站代理，默认关闭
HTTP_PROXY_HOST=
HTTP_PROXY_PORT=0

# -----------------------------------------------------------------------------
# 8. 登录 / JWT
# 生产环境建议替换 JWT_BASE64_SECRET_KEY。
# -----------------------------------------------------------------------------
# JWT_HEADER=Authorization
# JWT_TOKEN_START_WITH=Bearer
# JWT_BASE64_SECRET_KEY=YmEyOTE3YWJiOTdlNGRlMTllNzMwOTlmMGRkNzM0NjBkMDAyZjdhNGViNzE0NmU4OTk2YTEyNGFhZjE4YmE3Y2RkYWVlOGZkZDczMjRhMWM4ZDIwZmQ1ZDgzMDBiNGIw
# JWT_TOKEN_VALIDITY_IN_SECONDS=7200000
# JWT_ONLINE_KEY=nip_online:
# JWT_CODE_KEY=nip_code:
# JWT_DETECT=1800000
# JWT_RENEW=3600000
# JWT_DEFAULT_PASSWORD=Aa111111

# LOGIN_CACHE_ENABLE=true
# LOGIN_SINGLE_LOGIN=true
# LOGIN_LOGIN_CODE_CODE_TYPE=arithmetic
# LOGIN_LOGIN_CODE_EXPIRATION=2
# LOGIN_LOGIN_CODE_WIDTH=111
# LOGIN_LOGIN_CODE_HEIGHT=36
# LOGIN_LOGIN_CODE_LENGTH=2
# LOGIN_LOGIN_CODE_FONT_NAME=
# LOGIN_LOGIN_CODE_FONT_SIZE=25

# -----------------------------------------------------------------------------
# 9. 安全配置
# 生产环境建议替换 SM2 密钥。
# -----------------------------------------------------------------------------
# SECURITY_SM2_PRIVATE_KEY=266fcc0cd2495bbabd00d602bb6ade55d0cbe0ea587cc00025a9264516a34809
# SECURITY_SM2_PUBLIC_KEY=04a47da566fc10ac4458db04457226097c4c262a86b2325d01dfe7637c8e580af59b56e015756095d370e49d5ddab10c0c838ae1129555a70f4f0f10ca63b9e8d1

# -----------------------------------------------------------------------------
# 10. 富文本文件存储
# RICH_TEXT_STORAGE_TYPE 可选 LOCAL / QINIU。
# LOCAL 模式会写入 backend-uploads volume。
# -----------------------------------------------------------------------------
RICH_TEXT_STORAGE_TYPE=LOCAL
# RICH_TEXT_STORAGE_LOCAL_IMAGE_PATH=/root/nip/uploads/richtext/images
# RICH_TEXT_STORAGE_LOCAL_FILE_PATH=/root/nip/uploads/richtext/files

RICH_TEXT_STORAGE_QINIU_ACCESS_KEY=
RICH_TEXT_STORAGE_QINIU_SECRET_KEY=
RICH_TEXT_STORAGE_QINIU_BUCKET=
RICH_TEXT_STORAGE_QINIU_DOMAIN=
RICH_TEXT_STORAGE_QINIU_IMAGE_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 11. 前端 Nginx 运行时配置
# 这些是容器启动时生效的配置。
# -----------------------------------------------------------------------------
# NGINX_SERVER_NAME=_
NGINX_CLIENT_MAX_BODY_SIZE=50m
# NGINX_BACKEND_UPSTREAM=http://backend:12636
NGINX_DRAWIO_UPSTREAM=http://drawio:8080
# NGINX_ROOT_REDIRECT=/Writing/BasicWriting
# NGINX_SPA_FALLBACK=/Welcome/index.html
# NGINX_SSL_SESSION_TIMEOUT=5m
# NGINX_SSL_PROTOCOLS="TLSv1 TLSv1.1 TLSv1.2"
# NGINX_SSL_CIPHERS="ECDHE-RSA-AES128-GCM-SHA256:HIGH:!aNULL:!MD5:!RC4:!DHE"
