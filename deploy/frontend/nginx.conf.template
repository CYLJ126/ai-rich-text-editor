server {
    listen 8080;
    include /etc/nginx/tls/*.conf;
    server_name ${NGINX_SERVER_NAME};
    absolute_redirect off;
    charset utf-8;
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    root /usr/share/nginx/html;
    index index.html;

    location ^~ /arte/webSocket/ {
        proxy_pass ${NGINX_BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    location ^~ /arte {
        proxy_pass ${NGINX_BACKEND_UPSTREAM};
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Connection "close";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /drawio {
        return 301 /drawio/;
    }

    location ^~ /drawio/ {
        proxy_pass ${NGINX_DRAWIO_UPSTREAM}/;
        proxy_redirect ${NGINX_DRAWIO_UPSTREAM}/ /drawio/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /drawio;
    }

    location = / {
        return 302 ${NGINX_ROOT_REDIRECT};
    }

    location @router {
        rewrite ^.*$ ${NGINX_SPA_FALLBACK} last;
    }

    location / {
        try_files $uri $uri/ $uri/index.html @router;
        gzip on;
        gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    }
}
